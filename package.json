{
  "name": "134-connect",
  "version": "0.2.1",
  "private": true,
  "description": "Open-source desktop client for the 134 VPN service",
  "main": "dist/electron/main/main.js",
  "author": "134 Connect contributors",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "test:run": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:electron": "tsc -p tsconfig.electron.json && esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/electron/preload/preload.js",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "core:fetch": "node scripts/fetch-xray.mjs && node scripts/fetch-tun2proxy.mjs",
    "package:windows": "npm run build && electron-builder --win nsis",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "40.6.1",
    "electron-builder": "26.8.1",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "7.3.1",
    "vitest": "4.1.10",
    "wait-on": "9.0.4"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "build": {
    "appId": "ru.134.connect",
    "productName": "134 Connect",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/xray",
        "to": "xray",
        "filter": [
          "xray.exe",
          "geoip.dat",
          "geosite.dat",
          "wintun.dll",
          "LICENSE",
          "LICENSE-wintun.txt"
        ]
      },
      {
        "from": "resources/tun2proxy",
        "to": "tun2proxy",
        "filter": [
          "tun2proxy-bin.exe",
          "wintun.dll",
          "LICENSE"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "134-Connect-${version}-${arch}.${ext}"
    },
    "nsis": {
      "perMachine": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
